import heapq

graph = {
    'Hospital': [('Junction A', 3), ('Junction B', 6)],
    'Junction A': [('Market', 4), ('Junction C', 5)],
    'Junction B': [('Junction C', 2)],
    'Market': [('Emergency Location', 6)],
    'Junction C': [('Emergency Location', 3)],
    'Emergency Location': []
}

heuristic = {
    'Hospital': 9,
    'Junction A': 7,
    'Junction B': 5,
    'Market': 6,
    'Junction C': 3,
    'Emergency Location': 0
}


def a_star(start, goal):
    queue = [(heuristic[start], 0, start, [start])]
    visited = set()

    while queue:
        f, g, node, path = heapq.heappop(queue)

        if node == goal:
            return path, g

        if node in visited:
            continue

        visited.add(node)

        for next_node, cost in graph[node]:
            new_g = g + cost
            new_f = new_g + heuristic[next_node]

            heapq.heappush(
                queue,
                (new_f, new_g, next_node, path + [next_node])
            )

    return None, None


path, distance = a_star('Hospital', 'Emergency Location')

print("Fastest Ambulance Route:")
print(" -> ".join(path))
print("Total Distance:", distance, "km")
