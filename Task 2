distance = [
    [0, 8, 6, 7, 5],
    [8, 0, 4, 3, 6],
    [6, 4, 0, 5, 7],
    [7, 3, 5, 0, 4],
    [5, 6, 7, 4, 0]
]

cities = ["Chennai", "Madurai", "Bengaluru", "Coimbatore", "Trichy"]


def total(x):
    return sum(distance[x[i]][x[i + 1]] for i in range(len(x) - 1))


def hill(x):
    while True:
        best = x[:]

        for i in range(1, len(x) - 1):
            new = x[:]
            new[i - 1], new[i] = new[i], new[i - 1]

            if total(new) < total(best):
                best = new

        if total(best) >= total(x):
            return x

        x = best


route = [0, 2, 1, 4, 3, 0]

print("Starting:", " -> ".join(cities[i] for i in route))
print("Starting distance:", total(route))

result = hill(route)

print("Best Route:", " -> ".join(cities[i] for i in result))
print("Best Distance:", total(result))
