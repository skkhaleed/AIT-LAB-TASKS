import math


def print_board(board):
    for i in range(3):
        print(" | ".join(board[3*i:3*i+3]))
        if i < 2:
            print("---+---+---")


def check_winner(board):
    wins = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for line in wins:
        if board[line[0]] == board[line[1]] == board[line[2]] != ' ':
            return board[line[0]]

    if ' ' not in board:
        return 'Tie'

    return None


def minimax(board, is_max):
    winner = check_winner(board)

    if winner == 'X':
        return 1
    if winner == 'O':
        return -1
    if winner == 'Tie':
        return 0

    scores = []

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'X' if is_max else 'O'

            score = minimax(board, not is_max)

            board[i] = ' '
            scores.append(score)

    if is_max:
        return max(scores)
    else:
        return min(scores)


board = [' '] * 9

print("TIC-TAC-TOE")
print("You are O, AI is X")

while True:
    print_board(board)

    move = int(input("Enter your position (0-8): "))

    if board[move] == ' ':
        board[move] = 'O'
    else:
        print("Position already occupied!")
        continue

    result = check_winner(board)

    if result == 'O':
        print_board(board)
        print("You win!")
        break

    if result == 'Tie':
        print_board(board)
        print("It's a tie!")
        break

    move = None
    best_score = -math.inf

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'X'

            score = minimax(board, False)

            board[i] = ' '

            if score > best_score:
                best_score = score
                move = i

    board[move] = 'X'

    result = check_winner(board)

    if result == 'X':
        print_board(board)
        print("AI wins!")
        break

    if result == 'Tie':
        print_board(board)
        print("It's a tie!")
        break
